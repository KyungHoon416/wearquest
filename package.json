{
  "name": "wearquest",
  "version": "0.1.0",
  "private": true,
  "description": "Fashion quest hybrid app prototype",
  "scripts": {
    "check": "node --check dist/app.js && node --check dist/auth.js && node --check dist/auth-config.js && node --check dist/firebase-config.js && node --check dist/firebase-client.js && node --check admin/admin.js && node --check functions/index.js && node --check dist/public-content.js",
    "native:sync": "cap sync",
    "native:ios": "cap open ios",
    "native:android": "cap open android",
    "test:auth": "node --test tests/auth-adapter.test.cjs",
    "test:rules": "node --test tests/firestore-rules.test.cjs",
    "test:admin": "node --test functions/test/core.test.js",
    "test:admin:integration": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8188 GCLOUD_PROJECT=demo-wearquest node --test functions/test/integration.test.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/android": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
